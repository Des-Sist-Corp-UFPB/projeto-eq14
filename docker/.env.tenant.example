# =============================================================================
# .env.tenant.example — MODELO de ambiente por secretaria (SPEC-15, Opção A)
# =============================================================================
# Este é o MODELO versionado (SEM segredos). NÃO o edite para um cliente real:
# para provisionar uma secretaria, rode
#
#   scripts/novo-ambiente.sh <slug> --nome "..." --dominio ... --porta ...
#
# que gera ambientes/<slug>/.env a partir daqui (com a senha do banco sorteada).
# Esse .env por ambiente vive no SERVIDOR, é git-ignored e NUNCA é versionado.
# Use com: docker compose --env-file ambientes/<slug>/.env -f docker/docker-compose.tenant.yml up -d
# =============================================================================

# Identificador (slug) do ambiente — kebab-case, sem espaços. Faz o namespacing de
# TODOS os recursos Docker (projeto/containers/rede/volume): caladrius-<TENANT>.
TENANT=campina-grande
# Nome de exibição (só para operação/documentação; não vai para a aplicação).
TENANT_NOME=Secretaria de Saúde de Campina Grande

# Imagem da aplicação — a MESMA do CI (uma imagem serve todos os ambientes).
APP_IMAGE=ghcr.io/des-sist-corp-ufpb/projeto-eq14:latest

# Porta no host (loopback). ÚNICA por ambiente — o Caddy faz o proxy do subdomínio
# para 127.0.0.1:<APP_PORT>. Ex.: 8114, 8115, 8116...
APP_PORT=8114

# Banco DEDICADO a esta secretaria (isolamento físico dos dados — RN-MT-03). A senha
# é sorteada pelo script; se provisionar à mão, use uma senha forte. NUNCA versione.
POSTGRES_DB=caladrius
POSTGRES_USER=caladrius
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE

# Domínio público desta secretaria (usado no proxy Caddy e como APP_URL_PUBLICA).
DOMINIO=campina.caladrius.app
APP_URL_PUBLICA=https://campina.caladrius.app

# --- Opcionais (todos POR AMBIENTE) ----------------------------------------
# Login social Google (SPEC-08). Redirect: https://<DOMINIO>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp (SPEC-10/11) — cada secretaria tem seu número/instância Evolution própria.
EVOLUTION_URL=
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_TOKEN=

# Observabilidade (SPEC-14). O service.name distingue a secretaria no Grafana central.
OTEL_SERVICE_NAME=caladrius-campina-grande
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=campina-grande
OTEL_LOGS_EXPORTER=otlp
# Interruptor mestre da telemetria (vazio = agente OTel inerte, RN-OBS-01).
JAVA_TOOL_OPTIONS=
