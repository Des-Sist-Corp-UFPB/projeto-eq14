# =============================================================================
# .gitignore — Projeto Spring Boot / Maven
# =============================================================================

# Diário local de deploy em markdown (anotações de troubleshooting — não versionar)
.deploy-changes*

# Permissões locais do Claude Code (allowlist pessoal — não versionar)
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Maven
# ---------------------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---------------------------------------------------------------------------
# IDEs
# ---------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
# Barra inicial pelo mesmo motivo do /logs/ mais abaixo: saída de build do IDE
# fica na raiz; sem a âncora o padrão engoliria qualquer pasta "out" do código.
/out/

# Eclipse / Spring Tool Suite
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NetBeans
nbproject/private/
nbbuild/
/dist/
nbdist/
.nb-gradle/

# ---------------------------------------------------------------------------
# Sistema operacional
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
# ATENÇÃO à barra inicial: sem ela, `logs/` casa com QUALQUER diretório chamado
# "logs" em qualquer profundidade — foi assim que
# src/main/resources/templates/logs/ (a tela da central de logs) ficou invisível
# ao git por dois commits, e o /logs subiu para produção estourando
# TemplateInputException (DT-31). O alvo aqui é só o diretório de log em
# runtime na raiz do projeto.
/logs/
spring.log

# ---------------------------------------------------------------------------
# Variáveis de ambiente — NUNCA versionar!
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# Template de .env por secretaria (SPEC-15) — versionado (sem segredos), apesar do .env.* acima
!docker/.env.tenant.example

# Ambientes provisionados por secretaria (multi-ambiente / SPEC-15) — cada .env tem segredos
/ambientes/

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker/data/

# ---------------------------------------------------------------------------
# Relatórios de ferramentas de qualidade/segurança
# ---------------------------------------------------------------------------
dependency-check-report.*
dependency-check-report/
spotbugsXml.xml
target/spotbugs/
target/dependency-check-report/

# ---------------------------------------------------------------------------
# Trivy
# ---------------------------------------------------------------------------
trivy-results.json
trivy-results.sarif

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.pid
*.seed
*.pid.lock
HELP.md

# Instalador avulso (driver de impressora HP) baixado por engano na raiz — não versionar
hplip.run
