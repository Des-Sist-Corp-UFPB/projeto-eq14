# =============================================================================
# Variáveis de ambiente — EXEMPLO
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env
#   3. NUNCA faça commit do .env (ele está no .gitignore)
#
# No servidor de produção, este arquivo fica em:
#   /home/ghactions/eq14/.env
# A variável APP_IMAGE é atualizada automaticamente pelo GitHub Actions.
# =============================================================================

# Imagem Docker da aplicação (atualizada automaticamente pelo CI/CD a cada deploy)
APP_IMAGE=ghcr.io/des-sist-corp-ufpb/projeto-eq14:latest

# Banco de dados — GERENCIADO PELO PROFESSOR (compartilhado).
# O host "postgres" é resolvido dentro da rede Docker da disciplina (DB_NETWORK).
DATABASE_URL=jdbc:postgresql://postgres:5432/eq14
DATABASE_USERNAME=eq14
DATABASE_PASSWORD=senha-enviada-pelo-professor

# Nome da rede Docker (externa) da disciplina onde o container "postgres" está.
# Descubra no Portainer (aba Networks) ou pergunte ao professor.
DB_NETWORK=nome-da-rede-da-disciplina

# A app é publicada em 127.0.0.1:8114 do host (mapeada no docker-compose.prod.yml).
# O Caddy já faz proxy de https://eq14.dsc.rodrigor.com → 127.0.0.1:8114.
# A porta INTERNA da app continua 8080 — não é necessário alterar SERVER_PORT.

# =============================================================================
# Observabilidade com OpenTelemetry (SPEC-14) — OPCIONAL
# -----------------------------------------------------------------------------
# Sem estas variáveis o app sobe idêntico: o agente OTel existe na imagem mas fica
# INERTE (JAVA_TOOL_OPTIONS vazio → a JVM não o carrega). Preencha-as para exportar
# traces/métricas/logs ao backend CENTRAL da disciplina (Grafana+Tempo+Prometheus+Loki).
#
#  🔒 O token da turma é SEGREDO — NUNCA faça commit dele (este .env está no .gitignore).
#     Um erro 401 na ingestão = token ausente/errado no header.
#     Painel: https://otel.dsc.rodrigor.com  (Explore → filtre service.name=dsc-eq14)
# =============================================================================

# Identidade da equipe no Grafana (o filtro que separa a eq14 das outras). Use ESTE valor.
OTEL_SERVICE_NAME=dsc-eq14
# Endpoint OTLP central (base, SEM /v1/...). O agente monta o caminho por sinal.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.dsc.rodrigor.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Token da turma (SEGREDO — pegue no Discord da disciplina). NÃO use aspas: o Compose
# leria as aspas como parte do header e a ingestão responderia 401.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer COLE_AQUI_O_TOKEN_DA_TURMA
# Distingue o ambiente nos sinais (traces/logs/métricas).
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
# Exporta os logs da aplicação para o Loki via OTLP.
OTEL_LOGS_EXPORTER=otlp
# INTERRUPTOR MESTRE: liga o agente na JVM. Sem esta linha, a telemetria fica desligada.
JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

# =============================================================================
# Integração WhatsApp — Evolution API (SPEC-10 / SPEC-11) — OPCIONAL
# -----------------------------------------------------------------------------
# Sem EVOLUTION_URL + EVOLUTION_API_KEY o app sobe idêntico: o bean do provedor NÃO é
# criado (WhatsappConfig, @ConditionalOnExpression), o canal WhatsApp opera como stub
# (só escreve no log) e o painel /whatsapp mostra "integração não configurada"
# (RN-WPP-02). Nada quebra — as notificações continuam saindo pelo canal in-app.
#
#  🔒 EVOLUTION_API_KEY e WHATSAPP_WEBHOOK_TOKEN são SEGREDOS — só no .env do servidor.
#
# Depois de preencher e recriar o container, pareie o número em:
#   https://eq14.dsc.rodrigor.com/whatsapp  (Conectar → ler o QR no celular)
# =============================================================================

# Base URL da Evolution na VPS da equipe (SEM barra no final).
EVOLUTION_URL=https://evo.exemplo.com
# apikey da Evolution (AUTHENTICATION_API_KEY do compose dela) — SEGREDO.
EVOLUTION_API_KEY=COLE_AQUI_A_APIKEY_DA_EVOLUTION
# Nome da instância na Evolution. Pode omitir: o default do código já é "caladrius".
EVOLUTION_INSTANCIA=caladrius
# Segredo do webhook: a Evolution o envia no header X-Webhook-Token e o
# WhatsappWebhookController o compara em tempo constante (RN-WPP-03). SEM ele, o webhook
# recusa TODAS as chamadas com 403 — ou seja, o bot não recebe nada. Gere um valor
# aleatório longo, ex.: openssl rand -hex 32
WHATSAPP_WEBHOOK_TOKEN=COLE_AQUI_UM_SEGREDO_ALEATORIO
# URL pública do app — é o endereço que o adaptador registra na Evolution como destino
# do webhook (<APP_URL_PUBLICA>/webhooks/whatsapp). Sem ela, o webhook não é registrado
# e o bot nunca recebe mensagem. SEM barra no final.
APP_URL_PUBLICA=https://eq14.dsc.rodrigor.com
